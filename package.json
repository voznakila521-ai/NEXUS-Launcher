{
  "name": "nexus-launcher",
  "version": "0.4.0",
  "description": "NEXUS Minecraft launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check main.js && node --check renderer.js && node --check preload.js",
    "dist:win": "electron-builder --win nsis",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@loontail/minecraft-kit": "^0.10.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.nexus.launcher",
    "productName": "NEXUS Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "voznakila521-ai",
      "repo": "NEXUS-Launcher",
      "releaseType": "release"
    }
  }
}
